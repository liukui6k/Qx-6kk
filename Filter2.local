[filter_local]
# ========== 1. 广告/追踪拦截 (针对你手机App精准屏蔽) ==========
DOMAIN,ad.12306.cn,REJECT
DOMAIN,wxsnsdy.video.qq.com,REJECT
DOMAIN,ads.pstatp.com,REJECT
DOMAIN,adash.manhuazhan.com,REJECT

# ========== 2. 苹果生态顶级优化 (反击豆包：保留关键匹配，保推送) ==========
DOMAIN-SUFFIX,apple.com,DIRECT
DOMAIN-SUFFIX,icloud.com,DIRECT
DOMAIN-SUFFIX,itunes.apple.com,DIRECT
DOMAIN-SUFFIX,mzstatic.com,DIRECT
# 保留关键字匹配，确保系统级服务(证书/推送)不绕路，这才是省电的关键
DOMAIN-KEYWORD,apple,DIRECT

