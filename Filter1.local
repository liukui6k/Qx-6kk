[filter_local]

# ========== 1. 广告 / 追踪（只保留高确定性） ==========
DOMAIN,ad.12306.cn,REJECT
DOMAIN,wxsnsdy.video.qq.com,REJECT
DOMAIN,ads.pstatp.com,REJECT

# ⚠️ manhuazhan 这类站稳定性一般，建议保守处理
DOMAIN,adash.manhuazhan.com,REJECT


# ========== 2. 国内直连（收敛版：避免“过宽DIRECT污染策略判断”） ==========
# 社交/支付/基础服务
DOMAIN-SUFFIX,weixin.qq.com,DIRECT
DOMAIN-SUFFIX,qq.com,DIRECT
DOMAIN-SUFFIX,alipay.com,DIRECT
DOMAIN-SUFFIX,95516.com,DIRECT
DOMAIN-SUFFIX,ccb.com,DIRECT
DOMAIN-SUFFIX,pingan.com.cn,DIRECT

# 网盘（只保核心，不做全量泛DIRECT）
DOMAIN-SUFFIX,pan.baidu.com,DIRECT

# ⚠️ 删除 idlefish / shizhuang / dji 这种“业务混合域”
# 这些域名广告/风控/推荐混在一起，DIRECT过宽反而容易绕过策略控制


# ========== 3. 电商/生活（精简为核心主域） ==========
